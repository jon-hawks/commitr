[
  {
    "name": "keep-recent",
    "action": {"type": "Keep"},
    "mostRecentVersions": {"keepCount": 30}
  },
  {
    "name": "keep-deployment-images",
    "action": {"type": "Keep"},
    "condition": {"tagState": "tagged", "tagPrefixes": ["keep-"]}
  },
  {
    "name": "delete-old-commitr-images",
    "action": {"type": "Delete"},
    "condition": {
      "tagState": "any",
      "packageNamePrefixes": ["commitr"],
      "olderThan": "30d"
    }
  }
]
